# =============================================================================
# DUCKSLATOR ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in your actual values
# cp env.example .env

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MongoDB connection URI
# Format: mongodb://username:password@host:port/database
# For local development: mongodb://localhost:27017/duckslator
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/duckslator
MONGODB_URI=mongodb://localhost:27017/duckslator

# =============================================================================
# JWT CONFIGURATION
# =============================================================================

# Secret key for signing JWT tokens (generate a strong random key)
# You can generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-super-secret-jwt-key-here

# =============================================================================
# GOOGLE OAUTH CONFIGURATION
# =============================================================================

# Google OAuth 2.0 Client ID from Google Cloud Console
# Get this from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google OAuth 2.0 Client Secret (if using server-side flow)
# Get this from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Google OAuth redirect URI
# Must match what's configured in Google Cloud Console
GOOGLE_REDIRECT_URI=http://127.0.0.1:8001/auth/google/callback

# =============================================================================
# EMAIL CONFIGURATION (SMTP)
# =============================================================================

# SMTP server for sending emails (default: Gmail)
SMTP_SERVER=smtp.gmail.com

# SMTP port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# Use SSL for SMTP connection (true/false)
SMTP_USE_SSL=false

# Email address to send emails from
# For Gmail, use your Gmail address
SENDER_EMAIL=your-email@gmail.com

# Email password or app password
# For Gmail, use an App Password (not your regular password)
# Generate at: https://myaccount.google.com/apppasswords
SENDER_PASSWORD=your-email-password-or-app-password

# =============================================================================
# APPLICATION URLs
# =============================================================================

# Backend base URL (used for email verification links)
BACKEND_BASE_URL=http://127.0.0.1:8001

# Frontend URL (used for password reset and OAuth redirects)
FRONTEND_URL=http://localhost:5173

# =============================================================================
# ENVIRONMENT
# =============================================================================

# Environment type (development/production)
# Used for conditional logic in the application
ENVIRONMENT=development
